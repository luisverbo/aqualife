# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente da Aqualife
# ─────────────────────────────────────────────────────────────

# Senha do painel de fotos (/admin). Escolha uma senha forte.
ADMIN_PASSWORD="troque-esta-senha"

# Token do Vercel Blob (armazenamento das fotos).
# É criado AUTOMATICAMENTE quando você conecta um Blob store ao projeto
# na Vercel. Localmente, rode:  vercel env pull .env.local
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
